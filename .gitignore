*.exe
*.exe~
*.dll
*.so
*.dylib

# Go workspace / environment
go.work
go.work.sum
.env
.tools/

# Python
.venv/
__pycache__/
*.pyc

# Editors
.idea/
.vscode/

# Runtime/user data
*.log
resource_stats.json
resource_app_history.json
notifications.json
